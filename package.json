{
  "name": "layoutpilot",
  "version": "0.8.0",
  "description": "AI-assisted PCB layout planning for JLCEDA / EasyEDA Pro",
  "author": "lineana-lyu",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lineana-lyu/LayoutPilot",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
    "lint": "eslint",
    "fix": "eslint --fix",
    "build": "npm run compile && ts-node ./build/packaged.ts",
    "test": "npm run test:domain && npm run test:net-informativeness && npm run test:constraint-policy && npm run test:core-association && npm run test:ownership-relation && npm run test:ownership-capability && npm run test:semantic-snapshot && npm run test:human-ownership && npm run test:physical-placement && npm run test:placement-command && npm run test:board-boundary && npm run test:placement-transaction && npm run test:workflow-state",
    "test:domain": "ts-node ./tests/domain.ts",
    "test:net-informativeness": "ts-node ./tests/netInformativeness.ts",
    "test:constraint-policy": "ts-node ./tests/constraintPolicy.ts",
    "test:core-association": "ts-node ./tests/coreAssociation.ts",
    "test:ownership-relation": "ts-node ./tests/ownershipRelation.ts",
    "test:ownership-capability": "ts-node ./tests/ownershipCapabilityProbe.ts",
    "test:semantic-snapshot": "ts-node ./tests/semanticSnapshot.ts",
    "test:human-ownership": "ts-node ./tests/humanOwnershipDecision.ts",
    "test:physical-placement": "ts-node ./tests/physicalPlacement.ts",
    "test:placement-command": "ts-node ./tests/placementCommand.ts",
    "test:board-boundary": "ts-node ./tests/boardBoundary.ts",
    "test:placement-transaction": "ts-node ./tests/placementTransaction.ts",
    "verify:package": "ts-node ./build/verifyPackage.ts",
    "test:workflow-state": "ts-node ./tests/workflowState.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@jlceda/pro-api-types": "^0.4.23",
    "@types/fs-extra": "^11.0.4",
    "esbuild": "^0.24.2",
    "eslint": "^9.37.0",
    "fs-extra": "^11.3.0",
    "jszip": "^3.10.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}

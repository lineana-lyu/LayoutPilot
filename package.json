{
  "name": "layoutpilot",
  "version": "0.0.1",
  "description": "AI-assisted PCB layout planning for JLCEDA / EasyEDA Pro",
  "author": "lineana-lyu",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lineana-lyu/LayoutPilot",
  "engines": { "node": ">=20.17.0" },
  "scripts": {
    "compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
    "lint": "eslint",
    "fix": "eslint --fix",
    "build": "npm run compile && ts-node ./build/packaged.ts",
    "test": "npm run test:domain && npm run test:constraint-policy && npm run test:core-association",
    "test:domain": "ts-node ./tests/domain.ts",
    "test:constraint-policy": "ts-node ./tests/constraintPolicy.ts",
    "test:core-association": "ts-node ./tests/coreAssociation.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@jlceda/pro-api-types": "^0.4.23",
    "@types/fs-extra": "^11.0.4",
    "esbuild": "^0.24.2",
    "eslint": "^9.37.0",
    "fs-extra": "^11.3.0",
    "ignore": "^7.0.3",
    "jszip": "^3.10.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}